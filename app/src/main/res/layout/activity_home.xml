<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- top bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/primary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- location -->
        <TextView
            android:id="@+id/txtLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="📍 detecting location..."
            android:textColor="@color/white"
            android:textSize="14sp"/>

        <!-- notification icon -->
        <TextView
            android:id="@+id/btnNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="🔔"
            android:textSize="20sp"/>

    </RelativeLayout>

    <!-- scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- greeting -->
            <TextView
                android:id="@+id/txtGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="hey there 👋"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="what do you need help with today?"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>

            <!-- search bar -->
            <EditText
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@color/white"
                android:hint="search for a service..."
                android:padding="12dp"
                android:textSize="14sp"
                android:textColor="@color/text_primary"/>

            <!-- categories heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="what do you need?"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <!-- categories grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="3"
                android:rowCount="2">

                <!-- plumber -->
                <LinearLayout
                    android:id="@+id/catPlumber"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@color/white"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔧"
                        android:textSize="28sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="plumber"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>

                <!-- electrician -->
                <LinearLayout
                    android:id="@+id/catElectrician"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@color/white"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="28sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="electrician"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>

                <!-- cleaner -->
                <LinearLayout
                    android:id="@+id/catCleaner"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@color/white"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧹"
                        android:textSize="28sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="cleaner"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>

                <!-- painter -->
                <LinearLayout
                    android:id="@+id/catPainter"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@color/white"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎨"
                        android:textSize="28sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="painter"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>

                <!-- carpenter -->
                <LinearLayout
                    android:id="@+id/catCarpenter"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@color/white"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🪚"
                        android:textSize="28sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="carpenter"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>

                <!-- more -->
                <LinearLayout
                    android:id="@+id/catMore"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@color/primary"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+"
                        android:textSize="28sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="more"
                        android:textSize="12sp"
                        android:textColor="@color/white"/>
                </LinearLayout>

            </GridLayout>

            <!-- nearby heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="top rated near you"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <!-- provider card 1 -->
            <RelativeLayout
                android:id="@+id/providerCard1"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                android:background="@color/white"
                android:padding="12dp">

                <TextView
                    android:id="@+id/providerName1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ramesh K."
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/providerSkill1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/providerName1"
                    android:layout_marginTop="4dp"
                    android:text="electrician • ₹299/hr"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/providerSkill1"
                    android:layout_marginTop="4dp"
                    android:text="⭐ 4.9 • 2km away"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>

                <Button
                    android:id="@+id/btnBook1"
                    android:layout_width="80dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@color/primary"
                    android:text="book"
                    android:textColor="@color/white"
                    android:textSize="12sp"/>

            </RelativeLayout>

            <!-- provider card 2 -->
            <RelativeLayout
                android:id="@+id/providerCard2"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                android:background="@color/white"
                android:padding="12dp">

                <TextView
                    android:id="@+id/providerName2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Suresh M."
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/providerSkill2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/providerName2"
                    android:layout_marginTop="4dp"
                    android:text="plumber • ₹249/hr"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/providerSkill2"
                    android:layout_marginTop="4dp"
                    android:text="⭐ 4.7 • 3km away"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>

                <Button
                    android:id="@+id/btnBook2"
                    android:layout_width="80dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@color/primary"
                    android:text="book"
                    android:textColor="@color/white"
                    android:textSize="12sp"/>

            </RelativeLayout>

        </LinearLayout>

    </ScrollView>

    <!-- bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏠"
            android:textSize="24sp"/>

        <TextView
            android:id="@+id/navExplore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔍"
            android:textSize="24sp"/>

        <TextView
            android:id="@+id/navBookings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📋"
            android:textSize="24sp"/>

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤"
            android:textSize="24sp"/>

    </LinearLayout>

</RelativeLayout>