<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:padding="24dp">

    <!-- big checkmark -->
    <TextView
        android:id="@+id/txtCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="✅"
        android:textSize="80sp"/>

    <!-- confirmed text -->
    <TextView
        android:id="@+id/txtConfirmed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtCheck"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:text="booking confirmed!"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"/>

    <!-- provider name -->
    <TextView
        android:id="@+id/txtProviderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtConfirmed"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="your provider will be notified"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"/>

    <!-- booking id -->
    <TextView
        android:id="@+id/txtBookingId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtProviderName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="booking id: #123456"
        android:textSize="13sp"
        android:textColor="@color/primary"/>

    <!-- go home button -->
    <Button
        android:id="@+id/btnGoHome"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/txtBookingId"
        android:layout_marginTop="40dp"
        android:background="@color/primary"
        android:text="back to home"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <!-- track booking -->
    <Button
        android:id="@+id/btnTrack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/btnGoHome"
        android:layout_marginTop="12dp"
        android:background="@color/surface"
        android:text="track my booking"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold"/>

</RelativeLayout>